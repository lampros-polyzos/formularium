# Backend settings, with DUMMY values. Copy this file to backend/.env and fill it in:
#
#     cp .env.example .env
#
# Spring Boot reads backend/.env automatically when started from this folder (spring.config.import in application.properties).
# On a host, set the same names as real environment variables instead. backend/.env is git-ignored: never put real values in this file.

# ---------------------------------------------------------------- database (required)
# JDBC address of any PostgreSQL. For Supabase: Connect > Session pooler, written as jdbc:postgresql://HOST:5432/postgres
# (credentials go in the two lines below, not in the address). The user must own the tables, not anon or authenticated.
# Use PORT 5432. Port 6543 is the TRANSACTION pooler, which breaks the driver's prepared statements and causes random failed requests;
# if you must use it, add ?prepareThreshold=0 to the address.
DATABASE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres
# For the Supabase pooler the user is postgres.<your-project-ref>
DATABASE_USER=postgres.YOUR_PROJECT_REF
DATABASE_PASSWORD=change-me
# Optional: how many connections to keep (default 5; the Supabase free plan is limited)
# DATABASE_POOL_SIZE=5

# ---------------------------------------------------------------- sign-in
# REQUIRED. Signs the access tokens: 32+ random characters, or the app refuses to start. Generate with:  openssl rand -base64 48
AUTH_JWT_SECRET=change-me-to-a-long-random-string-of-32-or-more-characters
# OAuth client ID of "Sign in with Google" (ends .apps.googleusercontent.com), never the client secret. Empty turns Google sign-in off.
# The same ID goes in the frontend as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Cloudflare Turnstile secret key. Empty skips the bot check (development only).
TURNSTILE_SECRET=
# Refresh cookie. Production: AUTH_COOKIE_SECURE=true. SameSite is Lax when the site and API share a domain,
# None when they do not (None needs AUTH_COOKIE_SECURE=true).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
# New email accounts must confirm their address before signing in. Set to false only for development without a mail server.
AUTH_REQUIRE_VERIFIED_EMAIL=true
# Refuse passwords that appear in known data breaches (the free haveibeenpwned.com range service; only a 5-character hash prefix is sent,
# and if the service is down the password is accepted). Leave on; switch off only where there is no internet access.
AUTH_BREACHED_PASSWORD_CHECK=true
# The header that carries the visitor's real address behind a proxy (counted by the sign-in limits). Leave empty locally. On Render: CF-Connecting-IP.
# Never X-Forwarded-For: visitors can write it.
CLIENT_IP_HEADER=
# Two-step verification (authenticator app). Base64 of 32 random bytes:  openssl rand -base64 32
# It encrypts the authenticator secrets in the database. Keep it SEPARATE from AUTH_JWT_SECRET and back it up: if it is lost or changed,
# every member's authenticator stops working. Empty switches the feature off (the settings screen then hides it).
AUTH_MFA_ENCRYPTION_KEY=

# ---------------------------------------------------------------- passkeys (sign in with a fingerprint, face or device PIN)
# A passkey is bound to a domain: WEBAUTHN_RP_ID is the website's domain, WEBAUTHN_ORIGINS its exact address(es), comma-separated. Leave both empty locally
# (localhost and http://localhost:5173). In production: formularium.dev and https://formularium.dev. Choose once: changing the id makes every passkey stop working.
# PASSKEYS_ENABLED=false switches the feature off.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGINS=http://localhost:5173
# PASSKEYS_ENABLED=true

# ---------------------------------------------------------------- "Try the demo" (temporary guest accounts)
# Each press makes a private account that is deleted after GUEST_TTL_HOURS, with everything in it. These are the defaults; uncomment to change them.
# GUEST_ENABLED=false switches the feature off.
# GUEST_ENABLED=true
# GUEST_TTL_HOURS=24
# GUEST_MAX_ACTIVE=200
# GUEST_PER_IP_PER_HOUR=10

# ---------------------------------------------------------------- email (confirmation and password-reset links)
# The website's address; the links in the emails point at it.
APP_URL=http://localhost:5173
# Option 1: Brevo's HTTPS API (an API key with only the "Transactional email" permission). The one to use on hosts that block SMTP, such as Render's free plan.
BREVO_API_KEY=
# Option 2: any SMTP server (Brevo, Resend, Mailgun, Amazon SES, Gmail with an app password...). Ignored when BREVO_API_KEY is set.
# Leave both empty to only log the emails, links included, instead of sending them: enough for trying sign-up locally.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Formularium <no-reply@example.com>

# ---------------------------------------------------------------- web
# Address(es) of the website allowed to call the API, separated by commas.
CORS_ALLOWED_ORIGIN=http://localhost:5173
