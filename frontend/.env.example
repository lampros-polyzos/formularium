# Frontend settings, with DUMMY values. Copy this file to frontend/.env.local and fill it in:
#
#     cp .env.example .env.local
#
# Everything here is baked into the public bundle and visible to anyone, so only PUBLIC values belong in it.
# Real secrets live in the backend (backend/.env). .env.local is git-ignored.

# Where the Spring Boot API lives. Development: http://localhost:8080. Production: the API's public address,
# or empty to call the same origin as the site.
VITE_API_BASE_URL=http://localhost:8080

# OAuth client ID of "Sign in with Google" (Google Cloud console > Credentials; ends .apps.googleusercontent.com).
# Never the client secret. Empty hides the button. The same ID goes in the backend as GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile SITE key (the public one) for the bot check on the sign-in forms. Empty skips the widget.
VITE_TURNSTILE_SITE_KEY=

# Public address of the site, used by `npm run build` for canonical links, the sitemap, llms.txt and structured data.
# Example: https://formularium.example
VITE_SITE_URL=
