# Every setting the project reads, with DUMMY values. This file documents them; nothing reads it directly.
#
# Backend: put real values in backend/config/application.properties (git-ignored, copy it from application.properties.example)
#          or set them as environment variables on your host, under the names below.
# Frontend: put real values in frontend/.env.local (git-ignored). Everything with a VITE_ prefix ends up in the public bundle, so only public values go there.
#
# NEVER put a real value in this file or in any file that git tracks.

# ---------------------------------------------------------------- backend: database
# JDBC address of any PostgreSQL (for Supabase: Connect > Session pooler). Credentials go in the two lines below, not in the address.
DATABASE_URL=jdbc:postgresql://db.example.com:5432/postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me

# ---------------------------------------------------------------- backend: sign-in
# Signs the access tokens. 32+ random characters; the app refuses to start without it. Generate with:  openssl rand -base64 48
AUTH_JWT_SECRET=change-me-to-a-long-random-string-of-32-or-more-characters
# The OAuth client ID of "Sign in with Google" (ends .apps.googleusercontent.com). Never the client secret. Empty turns Google sign-in off.
GOOGLE_CLIENT_ID=
# Cloudflare Turnstile secret key. Empty skips the bot check (development only).
TURNSTILE_SECRET=
# Production: true. SameSite is Lax when the site and API share a domain, None when they do not (needs AUTH_COOKIE_SECURE=true).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
# Require a confirmed email before signing in. Turn off only for development without a mail server.
AUTH_REQUIRE_VERIFIED_EMAIL=true

# ---------------------------------------------------------------- backend: email (confirmation and password reset links)
# The website's address, used in the links in emails.
APP_URL=http://localhost:5173
# Any SMTP server. Leave MAIL_HOST empty to only log the emails (links included) instead of sending them.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Formularium <no-reply@example.com>

# ---------------------------------------------------------------- backend: web
# Address(es) of the website allowed to call the API, separated by commas.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------- frontend (public values only)
# Where the API lives. Empty means the same origin as the site.
VITE_API_BASE_URL=http://localhost:8080
# Cloudflare Turnstile site key (public).
VITE_TURNSTILE_SITE_KEY=
# The same OAuth client ID as GOOGLE_CLIENT_ID above. Empty hides the Google button.
VITE_GOOGLE_CLIENT_ID=
# The public address of the site, used at build time for canonical links, the sitemap, llms.txt and structured data.
VITE_SITE_URL=
